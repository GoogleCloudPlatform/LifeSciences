# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Gemini Model Selection
COORDINATOR_MODEL_NAME=gemini-4-argon
WORKER_MODEL_NAME=gemini-3.8-flash

# Optional Default GCS Bucket for AlphaGenome Outputs
# When set, "list my alphagenome files" works without passing gs:// each time.
ALPHAGENOME_GCS_BUCKET=your-alphagenome-outputs-bucket
