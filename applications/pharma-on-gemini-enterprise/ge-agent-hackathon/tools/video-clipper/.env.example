# ---------------------------------------------------------------------------
# Video clipper configuration.
#   cp .env.example .env    then edit
#
# Model IDs are here, not in the code, on purpose. Gemini model IDs move — a
# "-preview" suffix is a scheduled outage, and IDs are withdrawn when a model
# reaches GA. When something 404s, change it here rather than editing scripts.
# ---------------------------------------------------------------------------

# --- Auth -----------------------------------------------------------------

# Default: Vertex AI with Application Default Credentials.
#   gcloud auth application-default login
#   gcloud config set project YOUR_PROJECT_ID
# The scripts pick the project up from `gcloud config` automatically, so this
# variable is only needed to override it.
# GOOGLE_CLOUD_PROJECT=your-project-id

# Vertex has NO Files API — video is inlined, which caps it near 20 MB. Set a
# bucket and anything larger is copied there automatically and deleted after.
# Real screen recordings are usually well over the cap, so set this.
# VIDEO_STAGING_BUCKET=your-bucket-name

# Alternative: a Gemini API key from https://aistudio.google.com/apikey.
# Uses the Files API instead (2 GB, no bucket needed). Either name works.
# A project always wins over a key, so unset the project to use this.
# GOOGLE_API_KEY=your-api-key


# --- Models ---------------------------------------------------------------
# Verified working at the time of writing. To check one yourself, see
# "Checking a model still exists" in README.md.

# Watches the raw recording and decides what to keep. The reasoning matters
# here, so this is the most capable tier.
VIDEO_CLIPPER_MODEL=gemini-3.1-pro-preview

# Watches the trimmed clip to time narration to what's on screen.
VIDEO_VISION_MODEL=gemini-3.6-flash

# Text to speech. Returns 24 kHz mono PCM.
VIDEO_TTS_MODEL=gemini-3.1-flash-tts-preview

# Cheap tier for searching/indexing a video's content.
VIDEO_SEARCH_MODEL=gemini-3.5-flash-lite


# --- Narration voice ------------------------------------------------------
# Prebuilt Gemini TTS voices: Puck, Charon, Kore, Fenrir, Aoede, and others.
# Puck is a good neutral default for product demos.
VIDEO_TTS_VOICE=Puck
