# ---------------------------------------------------------------------------
# Canonical .env reference for this kit.
#
# Copy the relevant block into the agent you're running:
#     cd agents/biocompass && cp ../../.env.example .env    # then edit
#
# Each agent also ships its own .env.example with only the keys it reads.
# .env is gitignored. Never commit one.
# ---------------------------------------------------------------------------


# === REQUIRED — everyone must set these ====================================

# Your Google Cloud project ID (not the number).
GOOGLE_CLOUD_PROJECT=your-project-id

# Use Gemini Enterprise (Vertex AI) rather than the AI Studio API.
# Supersedes GOOGLE_GENAI_USE_VERTEXAI. google-genai still reads the old name,
# but when both are set this one wins and the SDK warns.
GOOGLE_GENAI_USE_ENTERPRISE=1

# Where the AGENT is deployed. A real region — Agent Runtime does not accept
# "global". If a deploy fails with "resource exhaustion in this region", try
# us-east4 instead; it's a per-region quota, not a project-wide one.
GOOGLE_CLOUD_LOCATION=us-central1

# Where MODEL CALLS go. Gemini 3.x is served ONLY from the global endpoint.
# This is NOT the same as the line above, and conflating them produces a 404
# that reads like the model doesn't exist. Leave this as global.
MODEL_LOCATION=global


# === MODELS ================================================================
# Model IDs move. A "-preview" suffix is a scheduled outage — verify before a
# demo. gemini-3-pro-image-preview was withdrawn at GA; it is now
# gemini-3-pro-image.

COORDINATOR_MODEL_NAME=gemini-3.1-pro-preview
WORKER_MODEL_NAME=gemini-3.7-flash
IMAGE_MODEL_NAME=gemini-3-pro-image
IMAGE_SIZE=2K


# === RESILIENCE — read this if you're in a shared classroom project ========
#
# A 429 "RESOURCE_EXHAUSTED" with no quota metric named is DYNAMIC SHARED
# QUOTA. You cannot raise it with a quota-increase request. You can only be a
# better-behaved client, which is what these three knobs do.
#
# Why it matters here: ADK's default is NO RETRIES AT ALL. If you pass a model
# as a plain string, google-genai uses stop_after_attempt(1), so one transient
# 429 kills the whole invocation. This kit wraps models so retries are on.

# How many Gemini calls ONE process will have in flight at once.
#
# ⚠️  RAISING THIS CAUSES CONTENTION FOR EVERYONE ELSE ON THE PROJECT.
#     Quota is shared. Your burst is someone else's 429. In a classroom, if a
#     few people set this high, the whole room starts failing — and because
#     every failed call then retries, it gets worse, not better. Leave it at 3
#     unless you are certain you are alone on the project.
#
#   3    → default. Correct for a shared project. Keep it here.
#   8    → only if you are the sole user and you need the speed for a demo
#   0    → no cap. Don't.
#
# Measured cost of the cap: a light lookup takes ~30s at 8, ~57s at 3. You are
# trading latency for the room staying up.
LLM_MAX_CONCURRENCY=3

# Retry with jittered exponential backoff. google-genai retries 408/429/5xx.
LLM_RETRY_ATTEMPTS=5
LLM_RETRY_INITIAL_DELAY=1.0
LLM_RETRY_MAX_DELAY=30.0


# === BEHAVIOUR =============================================================

# How many times the critic loop revises the answer. Each round costs a full
# pass. Drop to 1 if you're latency-bound in a demo.
MAX_CRITIC_ROUNDS=2


# === OPTIONAL ==============================================================

# NCBI raises the E-utilities rate limit from 3 to 10 req/sec with a key.
# Worth having in a classroom — 30 people sharing an unauthenticated limit is
# its own bottleneck, separate from anything Gemini-related.
# Free: https://www.ncbi.nlm.nih.gov/account/settings/
# PUBMED_API_KEY=

# Only if your org blocks user ADC for Vertex. Works locally, but this name is
# RESERVED in the deployed runtime — strip it before `agents-cli deploy`, or
# use scripts/deploy.sh which does it for you.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/key.json
