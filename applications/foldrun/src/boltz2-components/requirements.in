# Pin PyTorch to a CUDA 12.6 wheel (`+cu126`) from the PyTorch wheel index so
# `boltz` runs cleanly on CUDA 12 GPU node drivers (default PyPI wheels for
# PyTorch >=2.13 link against CUDA 13) while remediating PyTorch CVEs.
# We install `boltz` (not `boltz[cuda]`) so pip does not pull cuequivariance
# wheels; `--no_kernels` at predict time falls back to standard PyTorch ops.
torch==2.14.1+cu126
boltz==2.2.1
# Bake kfp into the container so Vertex AI Pipelines run in air-gapped Shared
# VPC environments (`install_kfp_package=False`) without runtime PyPI access.
kfp>=2.16.1
pip>=26.2.2
