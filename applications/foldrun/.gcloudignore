#!include:.gitignore

# Environment and secrets
.env
*.env
.envrc
deployment_metadata.json

# Virtual environments
.venv/
venv/

# Terraform providers, state, and variables
terraform/.terraform/
terraform/.terraform.lock.hcl
terraform/terraform.tfstate*
terraform/backend.tf
*.tfvars
*.tfvars.json
*.tfstate*

# Python caches and compiled files
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Testing
.pytest_cache/
.coverage
htmlcov/

# IDE and tooling
.vscode/
.idea/
.ruff_cache/
.claude/

# Local development
.python-version

# OS
.DS_Store

# Build artifacts
build/
dist/
*.egg
*.whl

# Git
.git/
